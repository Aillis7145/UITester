@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion
cd /d "%~dp0"

rem ============================================================
rem  ProjectStart.bat — เปิดเซิร์ฟเวอร์ของโปรเจคให้คนอื่นในวงแลนเข้าดู
rem
rem  ดับเบิลคลิกไฟล์นี้ได้เลย ปิดหน้าต่างนี้ = ปิดเซิร์ฟเวอร์
rem
rem  ทุกครั้งที่รัน จะล้างของเก่าทิ้งก่อนเสมอ แล้วสร้างใหม่จากต้นทาง
rem  เพราะโค้ดหรือข้อมูลอาจถูกแก้มาก่อนหน้า การเสิร์ฟ dist เก่าจะโชว์ของที่ไม่ตรงกับโค้ด
rem ============================================================

rem ---------- ตั้งค่าตรงนี้ที่เดียว ----------
rem IP ที่ใช้เข้าเว็บ — ถ้าเครื่องย้ายวงแลนแล้วเลขเปลี่ยน ให้แก้บรรทัดนี้บรรทัดเดียว
set "IP=172.30.11.123"
set "PORT=4173"

echo.
echo ============================================================
echo   UITester — เปิดเซิร์ฟเวอร์สำหรับให้คนอื่นเปิดดู
echo   ที่อยู่ที่ใช้เข้า:  http://%IP%:%PORT%
echo ============================================================
echo.

rem ---------- 0) ตรวจว่า IP ที่ตั้งไว้ยังเป็นของเครื่องนี้จริง ----------
rem DHCP เปลี่ยนเลขให้เองได้ ถ้าไม่ตรวจ จะได้ลิงก์ที่ส่งให้คนอื่นแล้วเข้าไม่ได้โดยไม่รู้ตัว
ipconfig | findstr /c:"%IP%" >nul
if errorlevel 1 (
  echo [!] เครื่องนี้ไม่มี IP %IP% แล้ว — เลขอาจเปลี่ยนเพราะย้ายวงแลนหรือ DHCP
  echo     IP ที่เครื่องนี้มีอยู่ตอนนี้:
  for /f "tokens=2 delims=:" %%a in ('ipconfig ^| findstr /c:"IPv4"') do echo        %%a
  echo     แก้บรรทัด  set "IP=..."  ในไฟล์นี้ให้ตรงกับเลขข้างบน แล้วรันใหม่
  echo.
  echo     ระหว่างนี้จะเปิดเซิร์ฟเวอร์ให้ก่อน เข้าได้จากทุก IP ของเครื่อง
  echo.
)

rem ---------- 1) ปิดเซิร์ฟเวอร์เดิมที่ยังค้างอยู่บนพอร์ตนี้ ----------
rem ไม่ปิดก่อน vite จะขึ้น EADDRINUSE แล้วออก เพราะ config ตั้ง strictPort ไว้
echo [1/5] ปิดเซิร์ฟเวอร์เดิมบนพอร์ต %PORT% ...
set "KILLED="
for /f "tokens=5" %%p in ('netstat -ano ^| findstr /r /c:":%PORT% " ^| findstr "LISTENING"') do (
  taskkill /f /pid %%p >nul 2>&1
  if not errorlevel 1 set "KILLED=1"
)
if defined KILLED (echo       ปิดตัวเก่าเรียบร้อย) else (echo       ไม่มีตัวเก่าค้างอยู่)

rem ---------- 2) ล้างของเก่า ----------
echo [2/5] ล้าง dist และแคชของ vite ...
if exist "dist" rmdir /s /q "dist"
if exist "node_modules\.vite" rmdir /s /q "node_modules\.vite"

rem ติดตั้ง dependency ให้ด้วยถ้ายังไม่เคยลง — เครื่องใหม่จะได้รันไฟล์นี้ไฟล์เดียวจบ
if not exist "node_modules" (
  echo       ยังไม่มี node_modules — กำลังติดตั้ง dependency ครั้งแรก
  call npm install || goto :fail
)

rem ---------- 3) สร้างข้อมูลใหม่จากต้นทาง ----------
rem ทั้งสองตัวเป็นการแปลงล้วน ไม่ต้องต่อเน็ต และรันซ้ำได้ผลเดิมเป๊ะ
rem ถ้าต้นทางถูกแก้มาแล้วยังไม่ได้สร้างใหม่ เว็บจะโชว์ข้อมูลเก่าโดยไม่มีอะไรฟ้อง
echo [3/5] สร้างข้อมูลหลักสูตรและชุดข้อสอบใหม่จากต้นทาง ...
call npm run build:curriculum >nul 2>&1
if errorlevel 1 echo       [!] สร้างหลักสูตรไม่สำเร็จ — ใช้ไฟล์เดิมที่คอมมิตไว้ต่อไป
call npm run build:quizbank >nul 2>&1
if errorlevel 1 echo       [!] สร้างชุดข้อสอบไม่สำเร็จ — ใช้ไฟล์เดิมที่คอมมิตไว้ต่อไป

rem ---------- 4) build ----------
echo [4/5] build โปรเจค ...
call npm run build || goto :fail

rem ---------- 5) เปิดเซิร์ฟเวอร์ ----------
rem --host 0.0.0.0 ผูกกับทุก network interface โดยตั้งใจ
rem ผูกกับ %IP% ตัวเดียวจะทำให้ http://localhost:%PORT% บนเครื่องนี้เข้าไม่ได้
rem ซึ่งเป็นที่ที่คนทำงานเปิดดูบ่อยที่สุด — ผูกทุกอินเทอร์เฟซแล้วเข้าได้ทั้งสองทาง
echo [5/5] เปิดเซิร์ฟเวอร์ ...
echo.
echo       เครื่องอื่นในวงแลน:  http://%IP%:%PORT%
echo       เครื่องนี้:           http://localhost:%PORT%
echo.
echo       ปิดหน้าต่างนี้ หรือกด Ctrl+C เพื่อหยุดเซิร์ฟเวอร์
echo ============================================================
echo.

rem เปิดเบราว์เซอร์ให้ที่ IP ที่ตั้งไว้ หน่วงนิดหนึ่งรอเซิร์ฟเวอร์พร้อม
rem ใช้ ping หน่วงเวลาแทน timeout — timeout จะตายทันทีถ้า stdin ถูก redirect
rem (เกิดตอนสั่งรันจากสคริปต์อื่นแล้วเก็บ log ไว้) ส่วน ping ทำงานได้ทุกกรณี
start "" /b cmd /c "ping -n 5 127.0.0.1 >nul & start "" http://%IP%:%PORT%/"

call npm run preview -- --host 0.0.0.0 --port %PORT%
goto :eof

:fail
echo.
echo ============================================================
echo   [x] ทำงานไม่สำเร็จ — ดูข้อความผิดพลาดด้านบน
echo ============================================================
echo.
pause
exit /b 1
